#!/bin/sh
# 雅典娜 AX6600 首次启动的无线定制。
#
# 为什么不用 `uci set wireless.radio0/1/2.xxx`：
#   1. uci-defaults 跑在 /etc/init.d/wireless 之前，此时 /etc/config/wireless
#      还不存在。直接 uci set 会凭空造出一份没有 type/path 的残缺配置，
#      之后 wifi config 认不出来，会再追加 radio3/4/5 —— hostapd 起不来、
#      wpad 反复重启，表现就是"刷完机崩溃"。
#   2. AHB（IPQ6010 内置）和 PCIe（QCN9074）的探测顺序不保证，
#      radioN 编号在不同版本/不同次开机可能对调。
# 所以这里先把 wireless 配置正常生成出来，再按 band + path 匹配。
#
# 本脚本失败时返回非 0，OpenWrt 会保留它，下次开机自动重试。

COUNTRY='US'
TXPOWER='24'
KEY='11111111'
SSID_2G='N_2.4G'
CH_2G='11'
HTMODE_5G='HE80'
# 两块 5G 各给一个非 DFS 信道。
# 不能用 auto：ACS 会选到 DFS 信道（实测内置 5G 落在 ch100），
# 而 ath11k 的雷达检测(CAC)基本起不来，表现就是 SSID 完全搜不到。
# US 下非 DFS 只有 UNII-1(36-48) 和 UNII-3(149-165)，两块错开避免同机互扰。
CH_5G_BUILTIN='149'   # IPQ6018 内置 5G（AHB，2×2）
SSID_5G_BUILTIN='N_5G'
CH_5G_PCI='44'        # QCN9074（PCIe，4×4）
SSID_5G_PCI='N_5G_QCN'

# ath11k 的 phy 注册是异步的（固件要现加载），最多等 20s 等三个射频都上来。
# 只在首次启动付这个代价。
i=0
while [ "$(ls -d /sys/class/ieee80211/phy* 2>/dev/null | wc -l)" -lt 3 ] && [ "$i" -lt 20 ]; do
	sleep 1
	i=$((i + 1))
done

[ -s /etc/config/wireless ] || /sbin/wifi config
[ -s /etc/config/wireless ] || exit 1

# 取 radio 对应的 sysfs 路径。mac80211.uc 通常写 path=，个别情况写 phy=，两种都兜住。
radio_path() {
	local p
	p=$(uci -q get "wireless.$1.path")
	[ -n "$p" ] && { echo "$p"; return; }
	readlink -f "/sys/class/ieee80211/$(uci -q get "wireless.$1.phy")/device" 2>/dev/null
}

set_radio() {
	local dev="$1" ssid="$2" ch="$3" htmode="$4"
	uci -q set "wireless.$dev.disabled=0"
	uci -q set "wireless.$dev.country=$COUNTRY"
	uci -q set "wireless.$dev.txpower=$TXPOWER"
	uci -q set "wireless.$dev.channel=$ch"
	uci -q set "wireless.$dev.htmode=$htmode"
	uci -q set "wireless.default_$dev.ssid=$ssid"
	uci -q set "wireless.default_$dev.encryption=psk2+ccmp"
	uci -q set "wireless.default_$dev.key=$KEY"
	uci -q set "wireless.default_$dev.disabled=0"
}

DEVS=$(uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p')

# 每块射频各自配好，一块都不禁用。
# 早先的版本会保留 PCIe 那块、自动关掉内置 5G，理由是"QCN9074 4×4 更强"。
# 实测 QCN9074 起不来（LuCI 显示"设备未激活"），结果唯一能用的 5G 被关了。
# 关哪块是用户在 LuCI 上点一下的事，不该由固件按一个没验证过的硬件假设替他决定。
for dev in $DEVS; do
	case "$(uci -q get "wireless.$dev.band")" in
	2g)
		set_radio "$dev" "$SSID_2G" "$CH_2G" 'HT20'
		;;
	5g)
		case "$(radio_path "$dev")" in
		*pci*) set_radio "$dev" "$SSID_5G_PCI" "$CH_5G_PCI" "$HTMODE_5G" ;;
		*)     set_radio "$dev" "$SSID_5G_BUILTIN" "$CH_5G_BUILTIN" "$HTMODE_5G" ;;
		esac
		;;
	esac
done

uci commit wireless
exit 0
